#!/usr/bin/env python3
"""CLI for the Aorus RGB keyboard backlight, per-key colors and keypress flash.

Writes ~/.config/aorus-rgb/config.json and signals the daemon to reload it.
Run without arguments for the command list.
"""

import os
import sys
import json
import time
import glob
import re
import subprocess
import signal

# Add library paths. Inserted in reverse order so that REPO_SRC ends up first
# in sys.path: running from the Dev repo must use the repo sources, not the
# copy installed in ~/.local/share.
REPO_SRC = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src")
LOCAL_SRC = os.path.expanduser("~/.local/share/aorus-rgb")
for p in [LOCAL_SRC, REPO_SRC]:
    if os.path.exists(p) and p not in sys.path:
        sys.path.insert(0, p)

from aorus_rgb import (
    CONFIG_DIR, PID_FILE, EVDEV_TO_LED, KEY_ALIASES,
    get_theme_accent_color, is_inherit, load_config, parse_color,
    resolve_keys, resolve_lighting, save_config,
)

PRESETS_DIR = os.path.join(CONFIG_DIR, "presets")

GREEN, RED, DIM, CYAN, RESET = "\033[1;32m", "\033[1;31m", "\033[1;30m", "\033[1;36m", "\033[0m"
RULE = "═" * 60


def group_custom_keys(custom_keys):
    """Group keys sharing the same color and brightness, for display."""
    groups = {}
    for kname, cinfo in sorted(custom_keys.items()):
        label = (fmt_color(cinfo.get("color")), fmt_brightness(cinfo.get("brightness")))
        groups.setdefault(label, []).append(kname)
    return groups


def fmt_color(val):
    """Format a color value for display ('inherit' or [r, g, b])."""
    if is_inherit(val):
        return "inherit"
    if isinstance(val, (list, tuple)):
        return str(list(val))
    return str(val)

def fmt_brightness(val):
    """Format a brightness value for display ('inherit' or 'n/10')."""
    if is_inherit(val):
        return "inherit"
    return f"{val}/10"

def is_service_active():
    try:
        res = subprocess.run(["systemctl", "--user", "is-active", "aorus-rgb.service"],
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        return res.stdout.strip() == "active"
    except Exception:
        return False

def ensure_service_running():
    if not is_service_active():
        subprocess.run(["systemctl", "--user", "start", "aorus-rgb.service"])

def notify_daemon():
    ensure_service_running()
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, signal.SIGUSR1)
        except Exception:
            pass

def restart_service():
    subprocess.run(["systemctl", "--user", "restart", "aorus-rgb.service"])

def apply(changes, message):
    """Write config changes, wake the daemon, then report the resulting state."""
    cfg = load_config()
    cfg.update(changes)
    save_config(cfg)
    notify_daemon()
    print(message)
    cmd_status()


def cmd_status():
    cfg = load_config()
    # Same resolution as the daemon, so the status can never drift from what
    # the keyboard actually does.
    light = resolve_lighting(cfg)
    custom_keys = cfg.get("custom_keys", {})
    flash_desc = f"{fmt_color(cfg.get('flash_color'))} ({fmt_brightness(cfg.get('flash_brightness'))})"
    flash_on = light.flash and light.flash_brightness > 0
    lit = light.backlight and light.brightness > 0

    if light.is_dark:
        mode = "Clavier éteint"
        mode += " + flash réactif matériel (0 % CPU)" if flash_on else " (aucun effet)"
    else:
        mode = f"Clavier coloré {light.raw_bg} ({light.brightness}/10)"
        if custom_keys:
            mode += f" + {len(custom_keys)} touche(s) persos"
        mode += f" + flash {flash_desc}" if flash_on else " (statique)"

    print(RULE)
    print(f" Rétroéclairage : {GREEN + f'ALLUMÉ ({light.brightness}/10)' + RESET if lit else DIM + 'ÉTEINT' + RESET}")
    print(f" Effet Flash    : {GREEN + 'ACTIVÉ ' + flash_desc + RESET if flash_on else RED + 'DÉSACTIVÉ' + RESET}")
    print(f" Couleur active : {light.effective_bg if lit else '[0, 0, 0] (éteint)'}")
    print(f" Touches persos : {f'{len(custom_keys)} active(s)' if custom_keys else 'Aucune'}")
    print(f" Mode détecté   : {mode}")
    print(f" Service systemd: {GREEN + 'Actif' + RESET if is_service_active() else RED + 'Inactif' + RESET}")
    if custom_keys:
        print(" " + "─" * 60)
        for (col_str, bri_str), keys in group_custom_keys(custom_keys).items():
            print(f"  • {col_str} ({bri_str}) : {', '.join(keys)}")
    print(RULE)


def cmd_on():
    cfg = load_config()
    changes = {"backlight": True}
    if cfg.get("brightness", 10) == 0:
        changes["brightness"] = 10
    if cfg.get("bg_color") == [0, 0, 0]:
        saved = cfg.get("saved_color", [0, 180, 216])
        changes["bg_color"] = get_theme_accent_color() if saved == [0, 0, 0] else saved
    apply(changes, "✓ Rétroéclairage clavier ALLUMÉ.")


def cmd_off():
    apply({"backlight": False}, "✓ Rétroéclairage clavier ÉTEINT.")


def cmd_toggle():
    cfg = load_config()
    if cfg.get("backlight", True) and cfg.get("brightness", 10) > 0:
        cmd_off()
    else:
        cmd_on()

def cmd_brightness(val_str):
    val = parse_brightness_arg(val_str)
    if val is None or val == "inherit":
        print("Erreur: L'intensité du rétroéclairage doit être comprise entre 0 et 10.")
        return
    changes = {"brightness": val}
    if val > 0:
        changes["backlight"] = True
    apply(changes, f"✓ Intensité du rétroéclairage réglée à {val}/10.")

def cmd_flash_brightness(val_str):
    val = parse_brightness_arg(val_str)
    if val is None:
        print("Erreur: L'intensité du flash doit être comprise entre 0 et 10, ou 'inherit'.")
        return
    changes = {"flash_brightness": val}
    if val != 0:
        changes["flash"] = True
    desc = "INHERIT (hérite de l'intensité de chaque touche)" if val == "inherit" else f"{val}/10"
    apply(changes, f"✓ Intensité du flash réglée sur {desc}.")


def cmd_flash_color(color_str):
    col = parse_color_arg(color_str)
    if col is None:
        print(f"Erreur: Couleur '{color_str}' non reconnue.")
        print("Exemples: inherit, white, yellow, cyan, red, 028391, '#ffffff'")
        return
    desc = "INHERIT (hérite de la couleur de chaque touche)" if col == "inherit" else str(col)
    apply({"flash_color": col, "flash": True}, f"✓ Couleur du flash réglée sur {desc}.")

def cmd_flash(args):
    if not args:
        enabled = not load_config().get("flash", True)
        apply({"flash": enabled}, f"✓ Effet flash {'ACTIVÉ' if enabled else 'DÉSACTIVÉ'}.")
        return

    sub = args[0].lower().strip()
    if sub in ("on", "off"):
        apply({"flash": sub == "on"},
              f"✓ Effet flash {'ACTIVÉ' if sub == 'on' else 'DÉSACTIVÉ'}.")
    elif is_inherit(sub):
        apply({"flash_color": "inherit", "flash_brightness": "inherit", "flash": True},
              "✓ Effet flash réglé sur INHERIT (couleur et luminosité héritées de chaque touche).")
    elif sub in ("brightness", "intensity"):
        if len(args) > 1:
            cmd_flash_brightness(args[1])
        else:
            print("Usage: aorus rgb flash brightness <0-10|inherit>")
    elif sub == "color":
        if len(args) > 1:
            cmd_flash_color(args[1])
        else:
            print("Usage: aorus rgb flash color <inherit|white|yellow|cyan|028391|#hex>")
            print("Astuce: en terminal, passez les codes hex sans '#' (ex: ffffff) ou entre guillemets (ex: \"#ffffff\").")
    elif isinstance(parse_brightness_arg(sub), int):
        cmd_flash_brightness(sub)          # `aorus rgb flash 8`
    elif parse_color(sub) is not None:
        cmd_flash_color(sub)               # `aorus rgb flash cyan`
    else:
        print(f"Sous-commande flash inconnue: {sub}")

def cmd_color(color_str):
    rgb = parse_color(color_str)
    if rgb is None:
        print(f"Erreur: Couleur '{color_str}' non reconnue.")
        print("Exemples: theme, black, red, green, blue, cyan, orange, yellow, purple, 028391, '#028391'")
        return
    if rgb == [0, 0, 0]:
        # Black means "off": saved_color is kept so that `on` can restore the hue.
        apply({"bg_color": rgb, "backlight": False}, "✓ Couleur réglée sur NOIR (fond éteint détecté).")
    else:
        apply({"bg_color": rgb, "saved_color": rgb, "backlight": True},
              f"✓ Couleur réglée sur {rgb} (fond coloré détecté).")

def cmd_key_list():
    custom_keys = load_config().get("custom_keys", {})
    if not custom_keys:
        print("Aucune touche personnalisée configurée.")
        return
    print(f"Touches personnalisées actives ({len(custom_keys)}) :")
    for (col_str, bri_str), keys in group_custom_keys(custom_keys).items():
        print(f"  • Couleur: {col_str}, Luminosité: {bri_str} -> {', '.join(keys)}")


def cmd_key_clear():
    count = len(load_config().get("custom_keys", {}))
    apply({"custom_keys": {}},
          f"✓ {count} touche(s) personnalisée(s) réinitialisée(s). Clavier remis en couleur globale.")

def parse_color_arg(text):
    """Parse a color argument: returns "inherit", an [r, g, b] list, or None if unrecognized."""
    return "inherit" if is_inherit(text) else parse_color(text)


def parse_brightness_arg(text):
    """Parse a brightness argument: returns "inherit", an int 0-10, or None if invalid."""
    if is_inherit(text):
        return "inherit"
    try:
        value = int(text)
    except (TypeError, ValueError):
        return None
    return value if 0 <= value <= 10 else None


def parse_key_value(args):
    """Parse the <couleur[:luminosité]> [luminosité] arguments of `key`.

    Accepts red:10, red:inherit, red: , :10, inherit, red and `red 10`.
    Returns (color, brightness); raises ValueError with a user-facing message.
    """
    if ":" in args[0]:
        color_arg, brightness_arg = (part.strip() for part in args[0].split(":", 1))
    elif len(args) >= 2:
        color_arg, brightness_arg = args[0].strip(), args[1].strip()
    elif args[0].strip().isdigit():
        color_arg, brightness_arg = "inherit", args[0].strip()
    else:
        color_arg, brightness_arg = args[0].strip(), "inherit"

    color = parse_color_arg(color_arg)
    if color is None:
        raise ValueError(f"Couleur '{color_arg}' non reconnue.")
    brightness = parse_brightness_arg(brightness_arg)
    if brightness is None:
        raise ValueError(f"Luminosité invalide '{brightness_arg}'. Doit être entre 0 et 10 ou 'inherit'.")
    return color, brightness


def cmd_key_reset(key_spec):
    keys = resolve_keys(key_spec)
    if not keys:
        print(f"Erreur: Aucune touche reconnue pour '{key_spec}'.")
        return
    custom_keys = load_config().get("custom_keys", {})
    for k in keys:
        custom_keys.pop(k, None)
    apply({"custom_keys": custom_keys}, f"✓ Touche(s) réinitialisée(s): {', '.join(keys)}")


def cmd_key_help():
    print("Usage: aorus rgb key <touches> <couleur[:luminosité]> [luminosité]")
    print("       aorus rgb key <touches> reset | list | clear")
    print("\nHéritage : 'inherit' (ou 'auto', 'null', valeur vide) reprend la valeur")
    print("du niveau au-dessus. Cascade : clavier -> touche -> flash.")
    print("\nExemples:")
    print("  aorus rgb key wasd red:10       # rouge, luminosité 10")
    print("  aorus rgb key wasd red:         # rouge, luminosité héritée")
    print("  aorus rgb key wasd :10          # couleur héritée, luminosité 10")
    print("  aorus rgb key wasd inherit      # couleur et luminosité héritées")
    print("  aorus rgb key super,ctrl reset  # retour à la couleur globale")
    print("")
    cmd_key_list()


def cmd_key(args):
    if not args:
        cmd_key_help()
        return

    sub = args[0].lower().strip()
    if sub == "list":
        cmd_key_list()
        return
    if sub == "clear":
        cmd_key_clear()
        return
    # Both `key reset <touches>` and `key <touches> reset` are accepted.
    if sub == "reset":
        if len(args) < 2:
            print("Usage: aorus rgb key reset <touches>")
            return
        cmd_key_reset(args[1])
        return
    if len(args) >= 2 and args[1].lower().strip() == "reset":
        cmd_key_reset(args[0])
        return

    keys = resolve_keys(args[0])
    if not keys:
        print(f"Erreur: Aucune touche reconnue pour '{args[0]}'.")
        print("Aliases: super, ctrl, alt, shift, echap, return, suppre, backspace,")
        print("         wasd, zqsd, fleches, fkeys, modifiers, nav, numpad, digits...")
        return

    if len(args) < 2:
        print(f"Touches ciblées : {', '.join(keys)}")
        print(f"Usage: aorus rgb key {args[0]} <couleur[:luminosité]>")
        return

    try:
        color, brightness = parse_key_value(args[1:])
    except ValueError as err:
        print(f"Erreur: {err}")
        return

    custom_keys = load_config().get("custom_keys", {})
    for k in keys:
        custom_keys[k] = {"color": color, "brightness": brightness}
    apply({"custom_keys": custom_keys},
          f"✓ {len(keys)} touche(s) configurée(s) : {', '.join(keys)}\n"
          f"  Couleur: {fmt_color(color)}, Luminosité: {fmt_brightness(brightness)}")


# ----------------- PRESETS -----------------

# Config keys a preset captures and restores. saved_color rides along so that
# `on` restores the right hue after a preset that had the backlight off.
PRESET_KEYS = ("backlight", "brightness", "bg_color", "saved_color", "flash",
               "flash_brightness", "flash_color", "fade_duration", "custom_keys")


def preset_path(name):
    """Path of a preset, from a user-typed name. Returns None if the name is invalid."""
    name = name.strip().lower()
    if name.endswith(".json"):
        name = name[:-5]
    if not re.fullmatch(r"[a-z0-9_-]+", name):
        return None
    return os.path.join(PRESETS_DIR, f"{name}.json")


def preset_exists(name):
    path = preset_path(name)
    return bool(path) and os.path.exists(path)


def describe_preset(data):
    """One-line summary of a preset's content."""
    return (f"Fond {fmt_color(data.get('bg_color'))} ({fmt_brightness(data.get('brightness'))}) | "
            f"Flash {fmt_color(data.get('flash_color'))} ({fmt_brightness(data.get('flash_brightness'))}) | "
            f"{len(data.get('custom_keys', {}))} touche(s) persos")


def cmd_preset_save(name):
    path = preset_path(name)
    if not path:
        print(f"Erreur: Nom '{name}' invalide (lettres, chiffres, tirets et underscores seulement).")
        return
    cfg = load_config()
    data = {"name": os.path.basename(path)[:-5], "saved_at": time.strftime("%Y-%m-%d %H:%M:%S")}
    data.update({k: cfg[k] for k in PRESET_KEYS if k in cfg})
    os.makedirs(PRESETS_DIR, exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2)
    print(f"✓ Preset '{data['name']}' enregistré ({path}).")
    print(f"  {describe_preset(data)}")


def cmd_preset_load(name):
    path = preset_path(name)
    if not path or not os.path.exists(path):
        print(f"Erreur: Preset '{name}' introuvable.")
        cmd_preset_list()
        return
    try:
        with open(path) as f:
            data = json.load(f)
    except (OSError, ValueError) as err:
        print(f"Erreur lors de la lecture du preset '{name}': {err}")
        return
    apply({k: data[k] for k in PRESET_KEYS if k in data},
          f"✓ Preset '{os.path.basename(path)[:-5]}' chargé et appliqué.")


def cmd_preset_list():
    paths = sorted(glob.glob(os.path.join(PRESETS_DIR, "*.json")))
    if not paths:
        print("Aucun preset enregistré.")
        print("Astuce : 'aorus rgb preset save <nom>' enregistre la configuration active.")
        return
    print(f"Presets disponibles ({len(paths)}) :")
    for path in paths:
        name = os.path.basename(path)[:-5]
        try:
            with open(path) as f:
                data = json.load(f)
        except (OSError, ValueError):
            print(f"  • {name} (fichier illisible)")
            continue
        print(f"  • {CYAN}{name}{RESET} ({data.get('saved_at', 'date inconnue')}) : {describe_preset(data)}")


def cmd_preset_delete(name):
    path = preset_path(name)
    if not path or not os.path.exists(path):
        print(f"Erreur: Preset '{name}' introuvable.")
        return
    try:
        os.remove(path)
    except OSError as err:
        print(f"Erreur lors de la suppression : {err}")
        return
    print(f"✓ Preset '{os.path.basename(path)[:-5]}' supprimé.")


def cmd_preset(args):
    if not args:
        print("Usage: aorus rgb preset <save|load|list|delete> [nom]")
        print("       aorus rgb preset <nom>   - raccourci de 'preset load'")
        print("")
        cmd_preset_list()
        return

    sub = args[0].lower().strip()
    actions = {"save": cmd_preset_save, "load": cmd_preset_load, "apply": cmd_preset_load,
               "delete": cmd_preset_delete, "remove": cmd_preset_delete, "rm": cmd_preset_delete}
    if sub in ("list", "ls"):
        cmd_preset_list()
    elif sub in actions:
        if len(args) > 1:
            actions[sub](args[1])
        else:
            print(f"Usage: aorus rgb preset {sub} <nom>")
    elif preset_exists(sub):
        cmd_preset_load(sub)
    else:
        print(f"Sous-commande ou preset inconnu : '{sub}'")
        cmd_preset_list()


USAGE = """
Commandes disponibles :
  aorus rgb on | off | toggle            - Allume / éteint le rétroéclairage
  aorus rgb brightness <0-10>            - Intensité du clavier
  aorus rgb color <couleur>              - Couleur globale (theme, red, cyan, 028391, #hex)
  aorus rgb flash on | off               - Active / désactive le flash à la frappe
  aorus rgb flash brightness <0-10|inherit>
  aorus rgb flash color <couleur|inherit>
  aorus rgb key <touches> <couleur[:luminosité]>  - Colorie des touches
  aorus rgb key <touches> reset | list | clear
  aorus rgb preset save|load|delete <nom> - Configurations enregistrées
  aorus rgb preset list
  aorus rgb <nom-de-preset>              - Charge un preset
  aorus rgb status | restart

'inherit' (ou 'auto', 'null', vide) hérite du niveau au-dessus.
Cascade : clavier -> touche personnalisée -> flash."""


def needs_arg(name, handler, args):
    """Run handler on the first argument, or print the usage line if it is missing."""
    if args:
        handler(args[0])
    else:
        print(f"Usage: aorus rgb {name} <valeur>")


def main():
    args = sys.argv[1:]
    if args and args[0].lower() == "rgb":   # `aorus rgb ...` and `aorus-rgb ...` are equivalent
        args = args[1:]

    if not args:
        cmd_status()
        print(USAGE)
        return

    sub, rest = args[0].lower(), args[1:]
    if sub == "on":
        cmd_on()
    elif sub == "off":
        cmd_off()
    elif sub == "toggle":
        cmd_toggle()
    elif sub in ("brightness", "intensity"):
        needs_arg("brightness <0-10>", cmd_brightness, rest)
    elif sub == "color":
        needs_arg("color <theme|black|red|cyan|028391|#hex>", cmd_color, rest)
    elif sub == "flash":
        cmd_flash(rest)
    elif sub == "key":
        cmd_key(rest)
    elif sub == "preset":
        cmd_preset(rest)
    elif sub == "status":
        cmd_status()
    elif sub == "restart":
        restart_service()
        cmd_status()
    elif preset_exists(sub):        # a bare argument is a preset name...
        cmd_preset_load(sub)
    elif parse_color(sub) is not None:   # ...or a color
        cmd_color(sub)
    else:
        print(f"Commande inconnue: {sub}")
        sys.exit(1)


if __name__ == "__main__":
    main()
